NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=solver.testnet
# Path to a credentials JSON from `near login` OR a raw ed25519 private key
NEAR_PRIVATE_KEY=ed25519:...
CONTRACT_ID=covenant.testnet
# MPC Chain Signatures contract on NEAR testnet
MPC_CONTRACT_ID=v1.signer-prod.testnet
# Bitcoin testnet (chainsig.js + near-multichain default to testnet4)
BTC_NETWORK=testnet
MEMPOOL_API=https://mempool.space/testnet/api
# Bond size in yoctoNEAR (default 0.1 NEAR)
BOND_YOCTO=100000000000000000000000

# Offline: omit NEAR_* keys and use:
#   npx tsx solver.ts --dry-run --mock --intent covenant-demo-1
# Live settlement also needs BTC faucet funds on the derived address.
